(* Calculadora com atribuicoes e instrucao print *)
TOKENS
  NUM  = /[0-9]+/ ;
  ID   = /[a-zA-Z_][a-zA-Z0-9_]*/ ;
  SKIP = /[ \t\r\n]+/ ;

RULES
  calc    = { comando } ;
  comando = ID "=" expr ";" | "print" expr ";" ;
  expr    = term { ( "+" | "-" ) term } ;
  term    = factor { ( "*" | "/" ) factor } ;
  factor  = NUM | ID | "(" expr ")" ;
